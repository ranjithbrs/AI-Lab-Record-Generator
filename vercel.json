{
  "version": 2,
  "builds": [
    {
      "src": "app.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/generate",
      "dest": "app.py"
    },
    {
      "src": "/api/(.*)",
      "dest": "app.py"
    },
    {
      "src": "/",
      "dest": "frontend/login.html"
    },
    {
      "src": "/(.*\\.(html|css|js))",
      "dest": "frontend/$1"
    }
  ]
}
